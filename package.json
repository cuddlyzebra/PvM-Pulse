{
  "name": "pvm-pulse",
  "version": "0.1.0",
  "description": "A modern, cross-platform ability tracker overlay for combat content creators. Inspired by LeMageTank's RS3 Ability Tracker, rebuilt for simpler setup and a live OBS overlay.",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "package": "npm run build:renderer && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pvmpulse.app",
    "productName": "PvM Pulse",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "overlay/**/*",
      "data/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": { "target": "dmg", "icon": "build/icon.png" },
    "linux": { "target": "AppImage", "icon": "build/icon.png" }
  }
}
